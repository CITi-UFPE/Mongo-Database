{
  "name": "mern-boilerplate",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": "12.16.1"
  },
  "scripts": {
    "start-prod": "npm run build && node ./build/index.js",
    "docker:start:prod": "node ./build/index.js",
    "build": "npm run clean && npm run build-babel",
    "clean": "rimraf build && mkdirp build",
    "build-babel": "babel src -d build",
    "start-dev": "node --exec babel-node src/index.js",
    "server": "nodemon --exec babel-node src/index.js",
    "client": "npm start --prefix ../client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "dev:server": "nodemon src/index.js",
    "reseed": "babel-node src/utils/seed.js"
  },
  "author": "Nemanja Mitic (https://github.com/nemanjam)",
  "license": "ISC",
  "dependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/node": "^7.28.0",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-env": "^7.28.3",
    "@babel/register": "^7.28.3",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "config": "^4.1.1",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-list-endpoints": "^7.1.1",
    "express-session": "^1.18.2",
    "faker": "^5.5.3",
    "google-auth-library": "^10.5.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "ml-kmeans": "^7.0.0",
    "ml-logistic-regression": "^2.0.0",
    "ml-matrix": "^6.12.1",
    "ml-random-forest": "^2.1.0",
    "mongoose": "^8.19.3",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth2": "^0.2.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "mkdirp": "^3.0.1",
    "nodemon": "^3.1.10",
    "rimraf": "^6.1.0"
  },
  "keywords": []
}
