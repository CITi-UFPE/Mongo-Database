# Configuração do Google OAuth (variável de build)
VITE_GOOGLE_CLIENT_ID=seu-google-client-id-aqui

# Configuração do Google Gemini API (SENSÍVEL - usar Docker Secret em produção)
# Obtenha sua chave em: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=sua-gemini-api-key-aqui

# IMPORTANTE:
# 1. Copie este arquivo para .env
# 2. Substitua os valores pelos seus
# 3. NUNCA commite o arquivo .env no Git
# 4. Em PRODUÇÃO:
#    - Google Client ID: usar ARG no docker build
#    - Gemini API Key: usar Docker Secret (mais seguro)
